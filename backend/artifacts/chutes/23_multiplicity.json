  "claims": [
    {
      "id": "1",
      "text": "Most queries do not need the strongest model",
      "source": "\u00a73.1",
      "kind": "census",
      "family": "descriptive",
      "verdict": "supported",
      "where": "overview.json:ties.pairwise_tie_rate"
    },
    {
      "id": "2",
      "text": "Routing beats one good model on cost at near-equal quality",
      "source": "AC-1",
      "kind": "estimate",
      "family": "headline",
      "verdict": "supported",
      "where": "frontier.json:sweep"
    },
    {
      "id": "3",
      "text": "A router trained once measurably decays",
      "source": "\u00a714.1",
      "kind": "estimate",
      "family": "staleness",
      "verdict": "supported",
      "where": "staleness.json:summary.frozen_decay"
    },
    {
      "id": "4",
      "text": "The decay is about evaluation freshness",
      "source": "\u00a71 framing",
      "kind": "estimate",
      "family": "staleness",
      "verdict": "not supported",
      "where": "staleness.json:summary.attribution_new_models"
    },
    {
      "id": "5",
      "text": "A useful router needs under 1 MB and no GPU",
      "source": "O3",
      "kind": "census",
      "family": "descriptive",
      "verdict": "supported",
      "where": "frontier.json:sweep[0].artifact_kb"
    },
    {
      "id": "6",
      "text": "Uninformative batches make the score noise",
      "source": "\u00a76",
      "kind": "estimate",
      "family": "scoring rule",
      "verdict": "supported",
      "where": "metric.json:result.bins.bins"
    },
    {
      "id": "6b",
      "text": "...because similar models converge oracle and baseline",
      "source": "\u00a76",
      "kind": "estimate",
      "family": "scoring rule",
      "verdict": "not supported",
      "where": "metric.json:result.diagnosis.corr_info_vs_model_spread"
    },
    {
      "id": "7",
      "text": "Information-aware shrinkage fixes it",
      "source": "\u00a76.1",
      "kind": "estimate",
      "family": "scoring rule",
      "verdict": "supported",
      "where": "metric.json:result.ranking.overall"
    },
    {
      "id": "8",
      "text": "Normalised regret below 0.6 is achievable",
      "source": "AC-1",
      "kind": "census",
      "family": "descriptive",
      "verdict": "not supported",
      "where": "metric.json:result.oracle_luck"
    },
    {
      "id": "9",
      "text": "Low-rank item factors bridge to a feature-space prior",
      "source": "\u00a75.1",
      "kind": "estimate",
      "family": "cold start",
      "verdict": "not supported",
      "where": "coldstart.json:bridge.bridge_r2"
    },
    {
      "id": "10",
      "text": "Probe count tracks how well the pool explains a new model",
      "source": "\u00a75.3",
      "kind": "estimate",
      "family": "cold start",
      "verdict": "mixed",
      "where": "coldstart.json:lomo.summary"
    },
    {
      "id": "11",
      "text": "Component-wise \u03b3_q/\u03b3_t beats one shared \u03b3",
      "source": "\u00a74",
      "kind": "test",
      "family": "gamma decomposition",
      "verdict": "mixed",
      "where": "decomposition.json:replication.*.decomposition"
    },
    {
      "id": "12",
      "text": "Price should be read, not fitted",
      "source": "\u00a78.7",
      "kind": "test",
      "family": "price lane",
      "verdict": "supported",
      "where": "decomposition.json:replication.*.read_vs_learn"
    },
    {
      "id": "13",
      "text": "\u03b3 \u2248 0.999 is a sensible default",
